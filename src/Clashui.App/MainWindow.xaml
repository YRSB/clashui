<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clashui.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clashui">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 官方 TitleBar 控件：图标/标题/拖拽区一体；高度显式对齐 Tall(48px) 的系统按钮 -->
        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Clashui" Height="48"/>

        <Grid Grid.Row="1">
            <WebView2 x:Name="Panel"/>
            <InfoBar
                x:Name="Banner"
                IsOpen="False"
                IsClosable="False"
                Severity="Warning"
                Title="核心未运行"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <InfoBar.ActionButton>
                    <Button Content="打开数据目录" Click="OpenDataFolder_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>
    </Grid>
</Window>
