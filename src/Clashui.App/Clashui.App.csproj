<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Clashui.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>zh-Hans;zh-CN</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 不用 Microsoft.WindowsAppSDK 伞包：它会带上 Widgets/AI/ML/Search 等用不到的
         组件（自包含发布多出约 45MB 的 onnxruntime/DirectML 等）。按需引用子包，
         版本对齐 2.4.0 伞包当时的解析结果（Runtime 伞包锁 [2.4.0]） -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <!-- WinUI 2.3.6 传递依赖 IE 2.1.3，但 Runtime 2.4.0 的组件一致性校验（框架依赖模式强制）
         要求 2.1.6，显式钉住（同为伞包 2.4.0 的解析结果） -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clashui.Core\Clashui.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- NativeAOT 的原生 pdb 只服务调试器/WER dump 分析（应用日志堆栈名来自二进制内嵌元数据，
       不依赖 pdb），约 63MB 不进发布产物；bin\Release 下始终保留 -->
  <PropertyGroup>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- AOT 的原生 pdb 由链接器直接写进 publish 目录，上面的属性在部分 SDK（如 11 preview）下
       拦不住，发布后显式删除兜底 -->
  <Target Name="RemoveNativePdbFromPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)$(TargetName).pdb" Condition="Exists('$(PublishDir)$(TargetName).pdb')" />
  </Target>

  <!-- 仅保留中文 MUI：SatelliteResourceLanguages 对 WindowsAppSDK 的原生 mui 无效，发布后手动裁剪 -->
  <Target Name="TrimNonChineseMuis" AfterTargets="Publish" Condition="Exists('$(PublishDir)')">
    <ItemGroup>
      <_PublishDir Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
      <_ToRemove Include="@(_PublishDir)" Condition="'%(_PublishDir.Filename)' != 'Assets' and '%(_PublishDir.Filename)' != 'Microsoft.UI.Xaml' and '%(_PublishDir.Filename)' != 'zh-CN' and '%(_PublishDir.Filename)' != 'zh-TW' and '%(_PublishDir.Filename)' != 'zh-Hans'" />
    </ItemGroup>
    <RemoveDir Directories="@(_ToRemove)" Condition="'@(_ToRemove)' != ''" />
  </Target>

</Project>
